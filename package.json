{
  "name": "@tanaab/canon",
  "version": "0.15.0",
  "packageManager": "bun@1.4.4",
  "type": "module",
  "description": "Tanaab-based canon, skills, and plugin surfaces.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lando/leia": "^2.0.0",
    "@tanaab/codex-tools": "^1.0.3",
    "clawhub": "^0.26.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "mocha": "^12.0.2",
    "prettier": "^3.9.9",
    "vue-eslint-parser": "^10.4.1"
  },
  "scripts": {
    "build:task-author": "bun skills/task-author/scripts/build-distribution.js",
    "check:task-author": "bun skills/task-author/scripts/build-distribution.js --check",
    "codex:check": "codex-tools cache check",
    "codex:sync": "codex-tools cache sync",
    "format:check": "bun run --bun prettier . --check --ignore-unknown",
    "format:write": "bun run --bun prettier . --write --ignore-unknown",
    "lint:eslint": "bun run --bun eslint .",
    "lint": "bun run lint:eslint && bun run format:check",
    "test:unit": "bun run --bun mocha \"test/**/*.spec.js\" \"skills/**/test/**/*.spec.js\"",
    "test": "bun run test:unit",
    "check:package": "bun scripts/check-package-cli.js",
    "leia": "bun ./node_modules/.bin/leia"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanaabased/canon.git"
  },
  "homepage": "https://github.com/tanaabased/canon",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".codex-plugin/plugin.json",
    ".mcp.json",
    ".bun-version",
    ".node-version",
    "index.js",
    "openclaw.plugin.json",
    "AGENTS.md",
    "CHANGELOG.md",
    "INSTALLATION.md",
    "DEVELOPMENT.md",
    "assets/",
    "guidance/",
    "ideas/",
    "lib/",
    "references/",
    "scripts/",
    "skills/",
    "templates/",
    "test/task-management-fixtures.js",
    "utils/"
  ],
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "runtimeExtensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.11.3",
      "minGatewayVersion": "2026.11.3"
    },
    "build": {
      "openclawVersion": "2026.11.3",
      "pluginSdkVersion": "2026.11.3"
    }
  }
}
