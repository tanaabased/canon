{
  "name": "@tanaab/canon",
  "version": "0.10.0",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "description": "Tanaab-based canon, skills, and plugin surfaces.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanaab/codex-tools": "^1.0.0",
    "ansis": "^4.4.0",
    "debug": "^4.4.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "mocha": "^12.0.2",
    "prettier": "^3.9.8",
    "vue-eslint-parser": "^10.4.1",
    "yargs-parser": "^22.0.0"
  },
  "scripts": {
    "codex:check": "codex-tools cache check",
    "codex:sync": "codex-tools cache sync",
    "format:check": "bun run --bun prettier . --check --ignore-unknown",
    "format:write": "bun run --bun prettier . --write --ignore-unknown",
    "lint:eslint": "bun run --bun eslint .",
    "lint": "bun run lint:eslint && bun run format:check",
    "test:unit": "bun run --bun mocha \"test/**/*.spec.js\" \"skills/**/test/**/*.spec.js\"",
    "test": "bun run test:unit",
    "check:package": "bun scripts/check-package-cli.js"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanaabased/canon.git"
  },
  "homepage": "https://github.com/tanaabased/canon",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".codex-plugin/plugin.json",
    ".mcp.json",
    ".bun-version",
    ".node-version",
    "AGENTS.md",
    "CHANGELOG.md",
    "assets/",
    "guidance/",
    "ideas/",
    "lib/",
    "prompts/",
    "references/",
    "scripts/",
    "skills/",
    "templates/",
    "test/task-management-fixtures.js",
    "utils/"
  ]
}
